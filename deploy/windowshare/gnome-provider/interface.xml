<node>
  <interface name="org.deskflow.Seamless.Gnome50">
    <method name="WindowDragPreview">
      <arg name="session" type="s" direction="in"/>
      <arg name="generation" type="u" direction="in"/>
      <arg name="viewer" type="s" direction="in"/>
      <arg name="association" type="s" direction="in"/>
      <arg name="drag" type="t" direction="in"/>
      <arg name="sequence" type="t" direction="in"/>
      <arg name="action" type="s" direction="in"/>
      <arg name="x" type="i" direction="in"/>
      <arg name="y" type="i" direction="in"/>
      <arg name="placement" type="a{sv}" direction="out"/>
    </method>
    <method name="WatchWindowDrag">
      <arg name="session" type="s" direction="in"/>
      <arg name="generation" type="u" direction="in"/>
      <arg name="viewer" type="s" direction="in"/>
      <arg name="association" type="s" direction="in"/>
      <arg name="enabled" type="b" direction="in"/>
    </method>
    <signal name="WindowDragChanged">
      <arg name="session" type="s"/>
      <arg name="generation" type="u"/>
      <arg name="association" type="s"/>
      <arg name="observation" type="a{sv}"/>
    </signal>
    <method name="GetCapabilities">
      <arg name="version" type="u" direction="out"/>
      <arg name="shellVersion" type="s" direction="out"/>
      <arg name="capabilities" type="a{sv}" direction="out"/>
    </method>
    <method name="CreateSession">
      <arg name="session" type="s" direction="out"/>
      <arg name="generation" type="u" direction="out"/>
      <arg name="eisFd" type="h" direction="out"/>
    </method>
    <method name="CloseSession">
      <arg name="session" type="s" direction="in"/>
      <arg name="generation" type="u" direction="in"/>
    </method>
    <method name="LaunchViewer">
      <arg name="session" type="s" direction="in"/>
      <arg name="generation" type="u" direction="in"/>
      <arg name="executable" type="s" direction="in"/>
      <arg name="arguments" type="as" direction="in"/>
      <arg name="viewer" type="s" direction="out"/>
    </method>
    <method name="LaunchViewerWithViewport">
      <arg name="session" type="s" direction="in"/>
      <arg name="generation" type="u" direction="in"/>
      <arg name="executable" type="s" direction="in"/>
      <arg name="arguments" type="as" direction="in"/>
      <arg name="viewportFd" type="h" direction="in"/>
      <arg name="viewer" type="s" direction="out"/>
    </method>
    <method name="GetViewer">
      <arg name="session" type="s" direction="in"/>
      <arg name="generation" type="u" direction="in"/>
      <arg name="viewer" type="s" direction="in"/>
      <arg name="observation" type="a{sv}" direction="out"/>
    </method>
    <method name="GetViewerWithAssociation">
      <arg name="session" type="s" direction="in"/>
      <arg name="generation" type="u" direction="in"/>
      <arg name="viewer" type="s" direction="in"/>
      <arg name="association" type="s" direction="in"/>
      <arg name="observation" type="a{sv}" direction="out"/>
    </method>
    <!-- Read-only exact compositor-stage point; no EIS drain or delivery permit. -->
    <method name="ValidateRoutedPoint">
      <arg name="session" type="s" direction="in"/>
      <arg name="generation" type="u" direction="in"/>
      <arg name="viewer" type="s" direction="in"/>
      <arg name="request" type="s" direction="in"/>
      <arg name="x" type="d" direction="in"/>
      <arg name="y" type="d" direction="in"/>
      <arg name="expectedRevision" type="u" direction="in"/>
      <arg name="observation" type="a{sv}" direction="out"/>
    </method>
    <!-- Atomic same-native-state points: cutoff request, capture sequence,
         capture part, frozen stage x/y. No per-point drain or input submission. -->
    <method name="ValidateRoutedPoints">
      <arg name="session" type="s" direction="in"/>
      <arg name="generation" type="u" direction="in"/>
      <arg name="viewer" type="s" direction="in"/>
      <arg name="request" type="s" direction="in"/>
      <arg name="captureEpoch" type="s" direction="in"/>
      <arg name="points" type="a(ssudd)" direction="in"/>
      <arg name="expectedRevision" type="u" direction="in"/>
      <arg name="observation" type="a{sv}" direction="out"/>
    </method>
    <!-- Read-only two same-view Clutter update pairs at the frozen stage
         coordinate. Never a sender-EIS/Clutter/Qt event-drain permit. -->
    <method name="ObserveStageFrames">
      <arg name="session" type="s" direction="in"/>
      <arg name="generation" type="u" direction="in"/>
      <arg name="viewer" type="s" direction="in"/>
      <arg name="request" type="s" direction="in"/>
      <arg name="x" type="d" direction="in"/>
      <arg name="y" type="d" direction="in"/>
      <arg name="expectedRevision" type="u" direction="in"/>
      <arg name="observation" type="a{sv}" direction="out"/>
    </method>
    <!-- Caller-ordered compositor segment; exact inherited cutoff is echoed.
         orderingContract names a separately verified mapped native build or is
         empty with orderingLimit=mutter-eis-sync-build-unverified. It does not
         certify the caller's sender PONG, exact All gate or Qt queue by itself. -->
    <method name="DrainInputPrefix">
      <arg name="session" type="s" direction="in"/>
      <arg name="generation" type="u" direction="in"/>
      <arg name="viewer" type="s" direction="in"/>
      <arg name="request" type="s" direction="in"/>
      <arg name="x" type="d" direction="in"/>
      <arg name="y" type="d" direction="in"/>
      <arg name="expectedRevision" type="u" direction="in"/>
      <arg name="binding" type="a{sv}" direction="in"/>
      <arg name="budgetMs" type="u" direction="in"/>
      <arg name="segment" type="a{sv}" direction="out"/>
    </method>
    <method name="SelectInputPreparation">
      <arg name="session" type="s" direction="in"/>
      <arg name="generation" type="u" direction="in"/>
      <arg name="viewer" type="s" direction="in"/>
      <arg name="request" type="s" direction="in"/>
      <arg name="x" type="d" direction="in"/>
      <arg name="y" type="d" direction="in"/>
      <arg name="associations" type="as" direction="in"/>
      <arg name="binding" type="a{sv}" direction="in"/>
      <arg name="budgetMs" type="u" direction="in"/>
      <arg name="result" type="a{sv}" direction="out"/>
    </method>
    <method name="QueryInputPreparation">
      <arg name="session" type="s" direction="in"/>
      <arg name="generation" type="u" direction="in"/>
      <arg name="viewer" type="s" direction="in"/>
      <arg name="request" type="s" direction="in"/>
      <arg name="x" type="d" direction="in"/>
      <arg name="y" type="d" direction="in"/>
      <arg name="revision" type="u" direction="in"/>
      <arg name="binding" type="a{sv}" direction="in"/>
      <arg name="cleanup" type="b" direction="in"/>
      <arg name="result" type="a{sv}" direction="out"/>
    </method>
    <method name="ActivateInputPreparation">
      <arg name="session" type="s" direction="in"/>
      <arg name="generation" type="u" direction="in"/>
      <arg name="viewer" type="s" direction="in"/>
      <arg name="request" type="s" direction="in"/>
      <arg name="x" type="d" direction="in"/>
      <arg name="y" type="d" direction="in"/>
      <arg name="revision" type="u" direction="in"/>
      <arg name="binding" type="a{sv}" direction="in"/>
      <arg name="budgetMs" type="u" direction="in"/>
      <arg name="result" type="a{sv}" direction="out"/>
    </method>
    <method name="DrainInputPreparation">
      <arg name="session" type="s" direction="in"/>
      <arg name="generation" type="u" direction="in"/>
      <arg name="viewer" type="s" direction="in"/>
      <arg name="request" type="s" direction="in"/>
      <arg name="x" type="d" direction="in"/>
      <arg name="y" type="d" direction="in"/>
      <arg name="revision" type="u" direction="in"/>
      <arg name="binding" type="a{sv}" direction="in"/>
      <arg name="budgetMs" type="u" direction="in"/>
      <arg name="cleanup" type="b" direction="in"/>
      <arg name="result" type="a{sv}" direction="out"/>
    </method>
    <method name="FinishInputPreparation">
      <arg name="session" type="s" direction="in"/>
      <arg name="generation" type="u" direction="in"/>
      <arg name="viewer" type="s" direction="in"/>
      <arg name="request" type="s" direction="in"/>
      <arg name="x" type="d" direction="in"/>
      <arg name="y" type="d" direction="in"/>
      <arg name="revision" type="u" direction="in"/>
      <arg name="binding" type="a{sv}" direction="in"/>
      <arg name="budgetMs" type="u" direction="in"/>
    </method>
    <method name="ValidateCurrentHit">
      <arg name="session" type="s" direction="in"/>
      <arg name="generation" type="u" direction="in"/>
      <arg name="viewer" type="s" direction="in"/>
      <arg name="request" type="s" direction="in"/>
      <arg name="x" type="d" direction="in"/>
      <arg name="y" type="d" direction="in"/>
      <arg name="expectedRevision" type="u" direction="in"/>
      <arg name="observation" type="a{sv}" direction="out"/>
    </method>
    <signal name="Closed">
      <arg name="session" type="s"/>
      <arg name="generation" type="u"/>
      <arg name="reason" type="s"/>
    </signal>
    <signal name="Invalidated">
      <arg name="session" type="s"/>
      <arg name="generation" type="u"/>
      <arg name="revision" type="u"/>
      <arg name="reason" type="s"/>
    </signal>
  </interface>
</node>
